  m_Script: {fileID: 11500000, guid: f5e3baa961d25972983325a6f6a84961, type: 3}
  m_Name: DirectoryArrival
  m_EditorClassIdentifier: Chaldran.Runtime::Chaldran.DialogueDefinition
  lines:
  - speaker: "AVATAR"
    text: "The walls are gone. Grass moves beneath an open sky. Even the air sounds different."
  - speaker: "AVATAR"
    text: "But the same pressure is here. The quarantine released me; the Sorruin Engine did not."
  - speaker: "AVATAR"
    text: "That stone beside the path carries markings. I need to learn where I've arrived."
