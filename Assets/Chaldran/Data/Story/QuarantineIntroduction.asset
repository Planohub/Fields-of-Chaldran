  m_Script: {fileID: 11500000, guid: f5e3baa961d25972983325a6f6a84961, type: 3}
  m_Name: QuarantineIntroduction
  m_EditorClassIdentifier: Chaldran.Runtime::Chaldran.DialogueDefinition
  lines:
  - speaker: "QUARANTINE TERMINAL"
    text: "PERSONAL QUARANTINE. Read-only barrier active. The containment sentinel holds Write-Access."
  - speaker: "AVATAR"
    text: "That cyan anomaly is a weapon the Engine failed to suppress. I'll recover it and take the sentinel's permission token."
