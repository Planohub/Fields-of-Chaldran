  m_Name: DirectoryLibraryThreshold
  m_EditorClassIdentifier: Chaldran.Runtime::Chaldran.DialogueDefinition
  lines:
  - speaker: "AVATAR"
    text: "A library should open into rooms. This passage seems to fold back on itself."
  - speaker: "THRESHOLD INSCRIPTION"
    text: "READ-ONLY QUARANTINE. Occupant: Broken Oracle."
  - speaker: "AVATAR"
    text: "I found the prison. Now I need to understand what keeps it closed."
