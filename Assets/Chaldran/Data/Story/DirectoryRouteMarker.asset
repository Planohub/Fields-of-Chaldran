  m_Script: {fileID: 11500000, guid: f5e3baa961d25972983325a6f6a84961, type: 3}
  m_Name: DirectoryRouteMarker
  m_EditorClassIdentifier: Chaldran.Runtime::Chaldran.DialogueDefinition
  lines:
  - speaker: "ROUTE MARKER"
    text: "BROKEN ORACLE / COMPRESSED LIBRARY. Quarantine remains active."
  - speaker: "AVATAR"
    text: "The path turns north. The writing repeats where the stone is cracked, as though it cannot finish a sentence."
  - speaker: "AVATAR"
    text: "Whatever broke this record hasn't silenced the signal. I'll follow it to the entrance."
