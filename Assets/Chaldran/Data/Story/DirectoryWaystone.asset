  m_Script: {fileID: 11500000, guid: f5e3baa961d25972983325a6f6a84961, type: 3}
  m_Name: DirectoryWaystone
  m_EditorClassIdentifier: Chaldran.Runtime::Chaldran.DialogueDefinition
  lines:
  - speaker: "WAYSTONE INSCRIPTION"
    text: "USER DIRECTORY. Shared environment. Personal quarantine: released. External access: unavailable."
  - speaker: "AVATAR"
    text: "A field, a path, a stone. The Engine gives its rules familiar shapes."
  - speaker: "AVATAR"
    text: "The inscription points along the eastern path. A damaged record is still responding."
